    "test:report": "playwright show-report playwright-report",
    "build:test": "npm run build && npm run test",
    "promote": "./scripts/promote-to-prod.sh",
    "preflight:full": "npm run lint && tsc --noEmit && npx tsx --test tests/unit/*.test.ts && npm run build",

    "test:metrics": "npx tsx --test tests/unit/admin-metrics.test.ts",
    "test:viewer": "npx tsx --test tests/unit/viewer-frame-source.test.ts tests/unit/viewer-transport-lan.test.ts tests/unit/viewer-crop.test.ts tests/unit/viewer-sessions.test.ts tests/unit/viewer-session-store.test.ts tests/unit/viewer-signal-client.test.ts tests/unit/viewer-webrtc-loopback.test.ts tests/unit/viewer-watch-canvas.test.ts tests/unit/viewer-input-capture.test.ts tests/unit/viewer-input-sink.test.ts tests/unit/viewer-tailnet.test.ts tests/unit/viewer-audit.test.ts tests/unit/viewer-cdp-evaluate.test.ts",

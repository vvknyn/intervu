rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Profiles — user can read/write own profile, except the server-only billing and
    // retention fields (SERVER_ONLY_PROFILE_FIELDS in lib/billing/profile-store.ts; a unit
    // test keeps this list in step). The Admin SDK bypasses these rules.
    match /profiles/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(['stripe_customer_id', 'access_until', 'auto_renew', 'grants', 'billing_updated_at', 'retention_warned_for', 'retention_warned_at', 'retention_first_seen_at', 'paid_until', 'granted_until', 'stripe_subscription_id', 'stripe_subscription_status', 'stripe_current_period_end', 'billing_entitled', 'billing_event_created', 'stripe_last_payment_failed_at']);
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['stripe_customer_id', 'access_until', 'auto_renew', 'grants', 'billing_updated_at', 'retention_warned_for', 'retention_warned_at', 'retention_first_seen_at', 'paid_until', 'granted_until', 'stripe_subscription_id', 'stripe_subscription_status', 'stripe_current_period_end', 'billing_entitled', 'billing_event_created', 'stripe_last_payment_failed_at']);
      // No client delete: it would erase the paid-time record; account erase uses the Admin SDK.
    }

    // User-scoped collections — user can only access own documents
    match /stories/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.user_id;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.user_id;
    }

    match /sources/{docId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.user_id || resource.data.visibility == 'public');
      allow write: if request.auth != null && request.auth.uid == resource.data.user_id;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.user_id;
    }

    match /applications/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.user_id;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.user_id;
    }

    match /interview_questions/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.user_id;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.user_id;
    }

    match /favorite_questions/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.user_id;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.user_id;
    }

    match /tailored_resumes/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.user_id;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.user_id;
    }

    match /job_analyses/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.user_id;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.user_id;
    }

    match /interview_prep_cache/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.user_id;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.user_id;
    }

    match /job_views/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.user_id;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.user_id;
    }

    match /feedback/{docId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.user_id;
      allow read: if request.auth != null && request.auth.uid == resource.data.user_id;
    }

    // Followed companies — user-scoped subcollection
    match /users/{userId}/followedCompanies/{domain} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // App config — anyone can read, admin writes handled by Admin SDK
    match /app_config/{docId} {
      allow read: if true;
    }

    // Default deny — any collection/path not explicitly allowed above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

# TLS + reverse proxy for intervu.cc → Next standalone (docker compose).
# Caddy auto-provisions Let's Encrypt when DNS for intervu.cc points here.

intervu.cc, www.intervu.cc {
	encode gzip zstd
	reverse_proxy intervu:3000

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

{
  "_schema": {
    "titles": "string[] — job titles to OR together in the keyword query; empty if none named",
    "terms": "string[] — must-have skills/tech/domain words the user demands (map to must_have_skills / tech_stack / description)",
    "work_mode": "'remote' | 'hybrid' | 'onsite' | null  (→ work_type)",
    "employment_type": "'full_time' | 'part_time' | 'contract' | 'internship' | null",
    "location": { "country": "ISO-3166 alpha-2 or null", "state": "string|null", "city": "string|null" },
    "min_salary": { "amount": "integer per year or null", "currency": "ISO-4217 or null" },
    "min_years": "integer|null  (→ min_years_experience)",
    "experience_level": "'entry' | 'mid' | 'senior' | 'lead' | 'executive' | null",
    "posted_within_days": "integer|null (→ posted_ts >= now - N days)",
    "exclude_titles": "string[] — titles the user says NOT to show",
    "unparsed": "string[] — fragments the parser could not map; the UI must show these, never drop them silently"
  },

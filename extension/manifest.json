{
  "manifest_version": 3,
  "name": "Velai: check a job before you apply",
  "short_name": "Velai",
  "version": "0.3.2",
  "description": "On job pages, see how the role fits your Velai résumé, whether the posting looks current, and your résumé tailored to it.",
  "minimum_chrome_version": "116",
  "homepage_url": "https://velai.app",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Check this job with Velai",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://velai.app/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ]
}
